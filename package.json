    "firebase-admin": "^12.1.0",
    "form-data": "^4.0.1",
    "graphql": "^16.8.1",
    "graphql-type-json": "^0.3.2",
    "handlebars": "^4.7.8",
    "json2csv": "^6.0.0-alpha.2",
    "latest": "^0.2.0",
    "mailgun.js": "^10.2.1",
    "maxmind": "^4.3.24",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.47",
    "nestjs-i18n": "^10.4.5",
    "nodemailer": "^6.9.13",
