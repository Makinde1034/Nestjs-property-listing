{
  "name": "waseet-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node --inspect --max-old-space-size=4096 dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": " npm run migration:run && npm run seed && node --max-old-space-size=4096 dist/main ",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "commitlint": "commitlint --edit",
    "typeorm": "npm run build && ts-node ./node_modules/typeorm/cli",
    "migration:run": "npm run typeorm migration:run -- -d ./src/config/database/typeorm-datasource.ts",
    "migration:generate": "npm run typeorm -- -d ./src/config/database/typeorm-datasource.ts migration:generate ./src/database/migrations/$npm_config_name",
    "migration:create": "npm run typeorm -- migration:create ./src/database/migrations/$npm_config_name",
    "migration:revert": "npm run typeorm -- -d ./src/config/database/typeorm-datasource.ts migration:revert",
    "seed": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs seed:run  -d src/config/database/typeorm-datasource.ts",
    "seed:create": "ts-node ./node_modules/typeorm-extension/bin/cli.cjs seed:create  --name src/database/seeders/$npm_config_name",
    "seed:revert": "ts-node typeorm migration:revert -c seed"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
      "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": ".husky/commit-msg"
    }
  },
  "dependencies": {
    "@apollo/server": "^4.10.2",
    "@google-cloud/storage": "^7.10.1",
    "@keyv/redis": "^4.2.0",
    "@nestjs-modules/mailer": "^1.11.2",
    "@nestjs/apollo": "^12.1.0",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/bullmq": "^11.0.2",
