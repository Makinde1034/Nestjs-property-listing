<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>E-Invoice Template</title>
    <style>
      :root {
        --primary-color: #4f46e5;
        --secondary-color: #f3f4f6;
        --text-color: #4b5563;
        --border-color: #e5e7eb;
        --heading-color: #1f2937;
      }
      
      body {
        height: 942px;
        width: 795px;
        margin: 30px auto;
        font-family: 'Segoe UI', Arial, sans-serif;
        color: var(--text-color);
        background-color: #f9fafb;
      }
      
      .container {
        margin: 0;
        padding: 30px;
        background-color: white;
        box-sizing: border-box;
        position: relative;
        overflow: hidden;
        height: 842px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05), 0 10px 15px rgba(0, 0, 0, 0.03);
        border-radius: 8px;
      }
      
      /* Header Section */
      .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border-color);
        margin-bottom: 25px;
      }
      
      .invoice-title-section {
        text-align: center;
        flex-grow: 1;
      }
      
      .invoice-type {
        font-size: 28px;
        font-weight: 700;
        color: var(--heading-color);
        margin: 0;
        letter-spacing: 0.5px;
      }
      
      .invoice-meta {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-top: 10px;
      }
      
      .meta-item {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      
      .meta-label {
        font-size: 12px;
        text-transform: uppercase;
        color: var(--text-color);
        margin-bottom: 4px;
        font-weight: 600;
      }
      
      .meta-value {
        font-size: 14px;
        font-weight: 500;
      }
      
      /* Party Information Sections */
      .party-section {
        padding: 20px 0;
        margin-bottom: 15px;
      }
      
      .party-heading {
        font-size: 16px;
        font-weight: 600;
        color: var(--heading-color);
        margin-bottom: 15px;
        padding-bottom: 5px;
        border-bottom: 1px solid var(--border-color);
      }
      
      .party-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 20px;
      }
      
      .info-item {
        display: flex;
        flex-direction: column;
      }
      
      .info-label {
        font-size: 12px;
        color: var(--text-color);
        margin-bottom: 4px;
        font-weight: 500;
      }
      
      .info-value {
        font-size: 14px;
        font-weight: 600;
        color: var(--heading-color);
      }
      
      /* Tables Section */
      .tables-section {
        margin: 25px 0;
      }
      
      .tables-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 15px;
      }
      
      table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
        background-color: white;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--border-color);
      }
      
      th {
        background-color: var(--secondary-color);
        color: var(--heading-color);
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        padding: 10px;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
      }
      
      td {
        padding: 10px;
        font-size: 13px;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-color);
      }
      
      tr:last-child td {
        border-bottom: none;
      }
      
      /* Totals Section */
      .totals-section {
        margin-top: 30px;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
      }
      
      .total-row {
        display: flex;
        justify-content: space-between;
        width: 300px;
        padding: 8px 0;
        font-size: 14px;
      }
      
      .total-row:last-child {
        border-top: 1px solid var(--border-color);
        margin-top: 5px;
        padding-top: 10px;
        font-weight: 700;
        color: var(--heading-color);
        font-size: 16px;
      }
      
      .total-label {
        color: var(--text-color);
      }
      
      /* Footer Section */
      .invoice-footer {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 60px;
        background-color: var(--secondary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: var(--text-color);
        border-top: 1px solid var(--border-color);
      }
    </style>
  </head>
  <body>
    <div class='container'>
      <!-- Header Section -->
      <div class='invoice-header'>
        <div class='qr-code'>
          <!-- QR code placeholder -->
        </div>
        
        <div class='invoice-title-section'>
          <h1 class='invoice-type'>Invoice</h1>
          <div class='invoice-meta'>
            <div class='meta-item'>
              <span class='meta-label'>Date</span>
              <span class='meta-value'>{{createdDate}}</span>
            </div>
            <div class='meta-item'>
              <span class='meta-label'>Reference</span>
              <span class='meta-value'>{{referenceNumber}}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Seller Section -->
      <div class='party-section'>
        <h2 class='party-heading'>Seller Information</h2>
        <div class='party-info-grid'>
          <div class='info-item'>
            <span class='info-label'>Name</span>
            <span class='info-value'>{{sellerName}}</span>
          </div>
          <div class='info-item'>
            <span class='info-label'>CR Number</span>
            <span class='info-value'>{{sellerCRNumber}}</span>
          </div>
          <div class='info-item'>
            <span class='info-label'>Zatca Number</span>
            <span class='info-value'>{{sellerZatcaNumber}}</span>
          </div>
          <div class='info-item'>
            <span class='info-label'>Address</span>
            <span class='info-value'>{{sellerAddress}}</span>
          </div>
        </div>
      </div>

      <!-- Buyer Section -->
      <div class='party-section'>
        <h2 class='party-heading'>Buyer Information</h2>
        <div class='party-info-grid'>
          <div class='info-item'>
            <span class='info-label'>Name</span>
            <span class='info-value'>{{customerName}}</span>
          </div>
          <div class='info-item'>
            <span class='info-label'>CR Number</span>
            <span class='info-value'>{{customerCRNumber}}</span>
          </div>
          <div class='info-item'>
            <span class='info-label'>Zatca Number</span>
            <span class='info-value'>{{customerZatcaNumber}}</span>
          </div>
          <div class='info-item'>
            <span class='info-label'>Address</span>
            <span class='info-value'>{{customerAddress}}</span>
          </div>
        </div>
      </div>

      <!-- Tables Section -->
      <div class='tables-section'>
        <div class='tables-grid'>
          <!-- Products Table -->
          <table>
            <thead>
              <tr>
                <th>Product</th>
               
              </tr>
            </thead>
            <tbody>
              {{#each product}}
                <tr>
                  <td>{{name}}</td>
                
                </tr>
              {{/each}}
            </tbody>
          </table>

          <!-- VAT Table -->
          <table>
            <thead>
              <tr>
                <th>VAT</th>
                <th>VAT %</th>
              </tr>
            </thead>
            <tbody>
              {{#each itemVat}}
                <tr>
                  <td>{{vat}}</td>
                  <td>{{vatValue}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>

          <!-- Total with VAT Table -->
          <table>
            <thead>
              <tr>
                <th>Total With VAT</th>
              </tr>
            </thead>
            <tbody>
              {{!-- {{#each totalWithVat}} --}}
                <tr>
                  <td>{{totalWithVat}}</td>
                </tr>
              {{!-- {{/each}} --}}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Totals Section -->
      <div class='totals-section'>
        <div class='total-row'>
          <span class='total-label'>Total without VAT:</span>
          <span class='total-value'>{{sumTotalWithoutVat}}</span>
        </div>
        <div class='total-row'>
          <span class='total-label'>VAT:</span>
          <span class='total-value'>{{sumTotalVat}}</span>
        </div>
        <div class='total-row'>
          <span class='total-label'>Total with VAT:</span>
          <span class='total-value'>{{sumTotalWithVat}}</span>
        </div>
      </div>

      <!-- Footer -->
      <div class='invoice-footer'>
        <p>Thank you for your business</p>
      </div>
    </div>
  </body>
</html>