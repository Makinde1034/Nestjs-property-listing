<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Invoice</title>
    <style>
      @page { size: A4; margin: 1cm; } body { font-family: Arial, sans-serif;
      margin: 0; padding: 0; } .invoice-box { width: 100%; padding: 20px;
      border: 1px solid #eee; box-sizing: border-box; } .invoice-box table {
      width: 100%; line-height: inherit; text-align: left; border-collapse:
      collapse; } .invoice-box table td { padding: 5px; vertical-align: top; }
      .invoice-box table tr td:nth-child(2) { text-align: right; } .invoice-box
      table tr.top table td { padding-bottom: 20px; } .invoice-box table
      tr.information table td { padding-bottom: 40px; } .invoice-box table
      tr.heading td { background: #eee; border-bottom: 1px solid #ddd;
      font-weight: bold; } .invoice-box table tr.item td { border-bottom: 1px
      solid #eee; } .invoice-box table tr.item.last td { border-bottom: none; }
      .invoice-box table tr.total td:nth-child(2) { border-top: 2px solid #eee;
      font-weight: bold; }
    </style>
  </head>
  <body>
    <div class='invoice-box'>
      <h1>
        Hi!
        {{clientName}}
        you have Created an offer to
        {{type}}
        a property
        {{item}}.
      </h1>
      <table cellpadding='0' cellspacing='0'>
        <tr class='top'>
          <td colspan='2'>
            <table>
              <tr>
                <td class='title'>
                  <img src='WASEET' style='width: 100%; max-width: 300px' />
                </td>
                <td>
                  Invoice:
                  {{invoiceNumber}}<br />
                  Created:
                  {{createdDate}}<br />
                  Due:
                  {{dueDate}}
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr class='information'>
          <td colspan='2'>
            <table>
              <tr>
                <td>WASEET<br /></td>
                <td>{{clientName}}<br /></td>
              </tr>
            </table>
          </td>
        </tr>
        <tr class='heading'>
          <td>Payment Method</td>
        </tr>
        <tr class='heading'>
          <td>Item</td>
          <td>Price</td>
        </tr>
        <tr class='item'>
          <td>{{item}}</td>
          <td>${{price}}</td>
        </tr>
        <tr class='total'>
          <td></td>
          <td>Total: ${{price}}</td>
        </tr>
      </table>
    </div>
  </body>
</html>